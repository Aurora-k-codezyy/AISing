AIS_HOST=0.0.0.0
AIS_PORT=8200
AIS_RELOAD=0

AIS_DB_HOST=xxxx
AIS_DB_PORT=3306
AIS_DB_NAME=xxxx
AIS_DB_USER=xxxx
AIS_DB_PASSWORD=xxxx
AIS_DATABASE_URL_OVERRIDE=sqlite:///./data/ai_sing.db

AIS_DATA_DIR=./data
AIS_LOG_DIR=./logs
AIS_LOG_LEVEL=INFO
AIS_WORKER_ENABLED=true
AIS_ADMIN_USERNAME=admin
AIS_ADMIN_PASSWORD=admin123

# RVC training command.
# This command creates {model_dir}/model.pth and {model_dir}/model.index.
AIS_RVC_TRAIN_COMMAND=E:/miscol/AISing/.venv/Scripts/python.exe scripts/rvc/train_cli.py --input "{input}" --output-dir "{model_dir}" --job-id "{job_id}" --rvc-root E:/miscol/AISing/rvc-cli --rvc-python E:/miscol/AISing/.venv/Scripts/python.exe --gpu 0 --sample-rate 40000 --epochs 50 --batch-size 8 --save-every-epoch 10 --cpu-cores 4 --include-mutes 2 --cut-preprocess Automatic
AIS_RVC_MODEL_FILENAME=model.pth
AIS_RVC_INDEX_FILENAME=model.index

# Demucs vocal separation command.
# The server will discover Demucs standard outputs under {demucs_dir}, or use
# {vocals} and {instrumental} directly if your command writes those paths.
AIS_DEMUCS_COMMAND=E:/miscol/AISing/.venv/Scripts/python.exe -m demucs --two-stems=vocals --out "{demucs_dir}" "{input}"

# RVC inference command.
# {model_path} is automatically selected from this user's latest successful voice_train task.
AIS_RVC_INFER_COMMAND=E:/miscol/AISing/.venv/Scripts/python.exe scripts/rvc/infer_cli.py --input "{vocals}" --model "{model_path}" --output "{ai_vocal}" --rvc-root E:/miscol/AISing/rvc-cli --rvc-python E:/miscol/AISing/.venv/Scripts/python.exe --pitch 0 --index-rate 0.3 --f0-method rmvpe

# Optional fallback model used only when the user has no successful voice_train task.
AIS_ACTIVE_MODEL_PATH=E:/miscol/AISing/rvc-cli/logs/ai_sing_3/ai_sing_3_50e_2950s.pth

# Aliyun OSS. Public-read directory is expected; database stores public URLs.
AIS_OSS_ENABLED=false
AIS_OSS_ENDPOINT=https://xxxx
#AIS_OSS_INTERNAL_ENDPOINT=https://xxxx
AIS_OSS_BUCKET=xxxx
AIS_OSS_ACCESS_KEY_ID=xxxx
AIS_OSS_ACCESS_KEY_SECRET=xxxx
AIS_OSS_PUBLIC_BASE_URL=https://xxxx
AIS_OSS_KEY_PREFIX=ai-sing
AIS_OSS_UPLOAD_EXPIRE_SECONDS=900

